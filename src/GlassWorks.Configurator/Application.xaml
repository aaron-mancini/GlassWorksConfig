<!--
  Application definition. Note there is NO StartupUri here: the window is
  created in code (Application.xaml.vb) so the composition root can build the
  service graph and hand the MainViewModel to the view - see OnStartup.

  VB idiom: x:Class is *relative to the project's root namespace*
  ("GlassWorks.Configurator", set in the .vbproj). In a C# project you would
  write the fully qualified name; the VB XAML compiler prepends the root
  namespace for you. The same applies to every XAML file in this project.
-->
<Application x:Class="App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order matters: Styles.xaml consumes brushes from Colors.xaml. -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
