<!--
  Palette for the light theme. Keeping raw Color resources separate from the
  Brush resources means gradients/animations can reuse the colors, and a dark
  theme could swap this single dictionary.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base colors -->
    <Color x:Key="AppBackgroundColor">#FFF1F5F9</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>
    <Color x:Key="CardBorderColor">#FFE2E8F0</Color>
    <Color x:Key="TextPrimaryColor">#FF0F172A</Color>
    <Color x:Key="TextSecondaryColor">#FF64748B</Color>

    <!-- Brand: a deep glass-teal -->
    <Color x:Key="PrimaryColor">#FF0F766E</Color>
    <Color x:Key="PrimaryHoverColor">#FF115E59</Color>
    <Color x:Key="PrimaryLightColor">#FFCCFBF1</Color>

    <Color x:Key="DangerColor">#FFDC2626</Color>
    <Color x:Key="DangerLightColor">#FFFEE2E2</Color>

    <Color x:Key="HeaderBarColor">#FF0F172A</Color>

    <!-- Brushes (what controls actually consume) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}" />

    <SolidColorBrush x:Key="HeaderBarBrush" Color="{StaticResource HeaderBarColor}" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="HeaderAccentBrush" Color="#FF5EEAD4" />

    <SolidColorBrush x:Key="SubtleButtonBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="SubtleButtonHoverBrush" Color="#FFCBD5E1" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFCBD5E1" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF99F6E4" />

</ResourceDictionary>
